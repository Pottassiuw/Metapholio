---
// Um logotipo de tecnologia: o glifo do Simple Icons em uma cor, ou o monograma quando não há logotipo.
import {tech} from '../data/tech';
interface Props{name:string;size?:number}
const {name,size=28}=Astro.props;
const t=tech(name);
---
<span class="tech-mark" title={t.name} style={`--s:${size}px`}>
{t.path?<svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.path}/></svg>:<span class="tech-mono" aria-hidden="true">{t.mono}</span>}
<span class="tech-name">{t.name}</span>
</span>
