---
// Salas do museu: cada seção junta um mestre de domínio público a um recorte de Thiago pintado como
// personagem (o "um personagem, em pedaços" dos submenus de Metaphor). O conteúdo vive dentro da metáfora da obra.
import {projects,sections,route,asset} from '../data/portfolio';
import TechMark from './TechMark.astro';
interface Props{section:(typeof sections)[number]}
const {section}=Astro.props;
const list=projects.filter(p=>p.category===section.id);
type Room={artist:string;work:string;from:string;year:string;source:string;figure:string;figureAlt:string;story:string};
const rooms:Record<string,Room>={
 projetos:{artist:'Giovanni Battista Piranesi',work:'A ponte levadiça',from:'Carceri d’invenzione',year:'c. 1749–50',source:'The Met, Open Access',figure:'cidade',figureAlt:'Pintura de Thiago Nascimento: uma cidade suspensa nas nuvens dentro da silhueta do seu perfil.',story:'Nas prisões que Piranesi inventou, uma ponte sempre leva a outra.'},
 experiencia:{artist:'Katsushika Hokusai',work:'A grande onda de Kanagawa',from:'Trinta e seis vistas do monte Fuji',year:'c. 1830–32',source:'The Met, Open Access',figure:'viajante',figureAlt:'Pintura de Thiago Nascimento como um viajante de casaco branco, de costas, sobre ruínas.',story:'Os barcos atravessam a onda; o Fuji espera ao fundo.'},
 laboratorio:{artist:'Ernst Haeckel',work:'Discomedusae',from:'Kunstformen der Natur, prancha 8',year:'1904',source:'Wikimedia Commons, domínio público',figure:'mao',figureAlt:'Pintura de Thiago Nascimento com a mão no queixo, observando.',story:'Haeckel desenhava para entender como as coisas funcionavam. Eu faço isso com código.'},
 formacao:{artist:'Andreas Cellarius',work:'Planisphaerium Copernicanum',from:'Harmonia Macrocosmica',year:'1660',source:'Wikimedia Commons, domínio público',figure:'esfera',figureAlt:'Pintura da biblioteca de Thiago Nascimento: uma esfera armilar sobre livros e um gato.',story:'Um mapa do céu com o Sol no centro. No meu, o centro é o curso atual.'},
 contato:{artist:'Gustave Doré',work:'O albatroz',from:'A balada do velho marinheiro',year:'1876',source:'Wikimedia Commons, domínio público',figure:'olhar',figureAlt:'Pintura de Thiago Nascimento olhando para o alto.',story:'O albatroz trazia notícias. Hoje, um e-mail resolve.'},
};
const room=rooms[section.id];
const word=section.label.toUpperCase();
const pic=(path:string)=>({avif:asset(`images/${path}.avif`),webp:asset(`images/${path}.webp`)});
const art=pic(`museu/${section.id}`);
const figure=pic(`thiago/${room.figure}`);
const figureSize:Record<string,[number,number]>={cidade:[760,620],viajante:[430,400],mao:[360,340],esfera:[640,500],olhar:[520,380]};
const [fw,fh]=figureSize[room.figure];
const arrow='M4 12h16m-6-6 6 6-6 6';
const external='M6 18 18 6M6 6h12v12';
// Formação: posições nas órbitas (ângulo em graus, anel 1–3).
const orbit=(a:number,r:number)=>`--a:${a}deg;--r:${r}`;
---
<section class="scene room" id="conteudo" data-scene={section.id} aria-labelledby="scene-title">
<div class="room-flood" aria-hidden="true"></div>
<h1 class="scene-title" id="scene-title"><span class="sr-only">{section.title}</span><span class="scene-word" aria-hidden="true">{[...word].map((l,i)=><span class="scene-letter" style={`--i:${i}`}>{l}</span>)}</span></h1>

<figure class="room-figure"><picture><source type="image/avif" srcset={figure.avif}/><img src={figure.webp} alt={room.figureAlt} width={fw} height={fh} loading="eager"/></picture></figure>

<div class="room-body">
<p class="room-story">{room.story}</p>

{section.id==='projetos'&&<div class="bridge">
<picture class="room-art bridge-art"><source type="image/avif" srcset={art.avif}/><img src={art.webp} alt="" width="1100" height="1481"/></picture>
<p class="room-label"><strong>{room.artist}</strong><em>{room.work}</em><span>{room.from} · {room.year}</span><span>{room.source}</span></p>
<ol class="plaques">{list.map((p,i)=><li style={`--n:${i}`}><a class="plaque" href={route(p.id)}>
<span class="plaque-tag">{p.context}</span>
<span class="plaque-name">{p.name}</span>
<span class="plaque-sub">{p.subtitle}</span>
<span class="plaque-lead">{p.lead}</span>
<span class="plaque-tech">{p.tech.slice(0,5).map(n=><TechMark name={n} size={20}/>)}</span>
<svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow}/></svg></a></li>)}</ol>
</div>}

{section.id==='experiencia'&&<div class="sea">
<div class="sea-stage">
<picture class="room-art sea-art"><source type="image/avif" srcset={art.avif}/><img src={art.webp} alt="" width="2000" height="1341"/></picture>
<svg class="sea-path" viewBox="0 0 100 67" preserveAspectRatio="none" aria-hidden="true"><path d="M12 46 C 18 34 22 24 30 22 S 50 46 64 63"/></svg>
<span class="crest-node" style="--x:12%;--y:46%" aria-hidden="true">PIT</span>
<span class="crest-node is-now" style="--x:30%;--y:22%" aria-hidden="true">EDP</span>
<span class="crest-node is-next" style="--x:64%;--y:63%" aria-hidden="true">?</span>
</div>
<p class="room-label"><strong>{room.artist}</strong><em>{room.work}</em><span>{room.from} · {room.year}</span><span>{room.source}</span></p>
<ol class="crests">
<li class="crest"><span class="crest-mark">PIT</span><h2>Estágio no PIT</h2><p>Em São José dos Campos. O ReObserve começou aqui, como projeto de iniciação.</p><a class="crest-link" href={route('reobserve')}>ReObserve<svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow}/></svg></a></li>
<li class="crest is-now"><span class="crest-mark">EDP · atual</span><h2>Estágio na EDP</h2><p>Planejamento de manutenção de redes, com Python, Power BI, Excel, Databricks e ferramentas internas.</p><a class="crest-link" href={route('edp-helios')}>Helios<svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow}/></svg></a></li>
</ol>
</div>}

{section.id==='laboratorio'&&<div class="plate">
<figure class="print"><picture class="room-art"><source type="image/avif" srcset={art.avif}/><img src={art.webp} alt="" width="1050" height="1516"/></picture><figcaption>Tafel 8 · Discomedusae</figcaption></figure>
<p class="room-label"><strong>{room.artist}</strong><em>{room.work}</em><span>{room.from} · {room.year}</span><span>{room.source}</span></p>
<ol class="specimens">
{list.map((p,i)=><li><a class="specimen" href={route(p.id)}><span class="specimen-fig">Fig. {i+1}</span><span class="specimen-name">{p.name}</span><span class="specimen-lead">{p.lead}</span><span class="specimen-tech">{p.tech.join(' · ')}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow}/></svg></a></li>)}
<li><a class="specimen" href="https://github.com/Pottassiuw" target="_blank" rel="noopener noreferrer"><span class="specimen-fig">Fig. {list.length+1}</span><span class="specimen-name">Outros repositórios</span><span class="specimen-lead">Exercícios, configurações e estudos.</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={external}/></svg></a></li>
</ol>
</div>}

{section.id==='formacao'&&<div class="orrery-room">

<div class="orrery">
<div class="orrery-disc" aria-hidden="true"><picture><source type="image/avif" srcset={pic('museu/formacao-disco').avif}/><img src={pic('museu/formacao-disco').webp} alt="" width="1100" height="1100"/></picture></div>
<span class="orbit-ring" style="--r:1" aria-hidden="true"></span><span class="orbit-ring" style="--r:2" aria-hidden="true"></span><span class="orbit-ring" style="--r:3" aria-hidden="true"></span>
<ul class="bodies" aria-label="Formação, certificações e idiomas">
<li class="body is-sun"><span class="body-kind">Atual</span><b>Desenvolvimento de Software Multiplataforma</b><span>FATEC São José dos Campos — Prof. Jessen Vidal</span></li>
<li class="body" style={orbit(270,1)}><span class="body-kind">2023–24</span><b>Técnico em Desenvolvimento de Sistemas</b><span>TCC da ETEC: <a href={route('weeat')}>Weeat</a></span></li>
<li class="body" style={orbit(25,2)}><span class="body-kind">12/2025</span><b>IT Essentials · ITE 7.01</b><span>Cisco Networking Academy</span></li>
<li class="body" style={orbit(150,2)}><span class="body-kind">10/2025</span><b>Linux Unhatched</b><span>Cisco Networking Academy</span></li>
<li class="body is-tongue" style={orbit(40,3)}><b>Português</b><span class="tongue">Nativo</span></li>
<li class="body is-tongue" style={orbit(70,3)}><b>Inglês</b><span class="tongue">C1</span></li>
<li class="body is-tongue" style={orbit(125,3)}><b>Espanhol</b><span class="tongue">B2</span></li>
<li class="body is-tongue" style={orbit(215,3)}><b>Italiano</b><span class="tongue">B1</span></li>
</ul>
</div>
<p class="room-label"><strong>{room.artist}</strong><em>{room.work}</em><span>{room.from} · {room.year}</span><span>{room.source}</span></p>
</div>}

{section.id==='contato'&&<div class="letters">
<picture class="room-art albatross"><source type="image/avif" srcset={art.avif}/><img src={art.webp} alt="" width="1400" height="1867"/></picture>
<p class="room-label"><strong>{room.artist}</strong><em>{room.work}</em><span>{room.from} · {room.year}</span><span>{room.source}</span></p>
<figure class="official"><div class="official-pair">
<picture><source type="image/avif" srcset={pic('thiago/foto-frontal').avif}/><img src={pic('thiago/foto-frontal').webp} alt="Thiago Nascimento, de frente, de óculos e camisa preta." width="900" height="900" loading="lazy"/></picture>
<picture><source type="image/avif" srcset={pic('thiago/foto-perfil').avif}/><img src={pic('thiago/foto-perfil').webp} alt="Thiago Nascimento de perfil, de óculos e camisa preta." width="900" height="900" loading="lazy"/></picture>
</div><figcaption>Retrato oficial · Thiago Nascimento</figcaption></figure>
<ul class="messages">
<li><a class="message" href="mailto:pottassiuw@proton.me"><span class="message-name">E-mail</span><span class="message-sub">pottassiuw@proton.me</span></a></li>
<li><a class="message" href="https://github.com/Pottassiuw" target="_blank" rel="noopener noreferrer"><span class="message-name">GitHub</span><span class="message-sub">Pottassiuw</span></a></li>
<li><a class="message" href="https://www.linkedin.com/in/thiago-nascimento-729077292" target="_blank" rel="noopener noreferrer"><span class="message-name">LinkedIn</span><span class="message-sub">Thiago Nascimento</span></a></li>
<li><a class="message" href={route()}><span class="message-name">Voltar ao menu</span><span class="message-sub">Recomeçar a visita</span></a></li>
</ul>
</div>}
</div>
</section>
