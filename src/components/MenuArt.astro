---
import {sections,route} from '../data/portfolio';
import Picture from './Picture.astro';
interface Props{active?:string;home?:boolean}
const {active='projetos',home=false}=Astro.props;
---

<Picture src="melencolia-anjo" imgClass="art" width={1200} height={1783} alt="" fetchpriority="high"/>
<div class="wash" aria-hidden="true"></div><div class="cut" aria-hidden="true"></div><div class="red-cut" aria-hidden="true"></div><div class="orbit" aria-hidden="true"></div>
<header>
<a class="identity" href={route()} aria-label="Thiago Nascimento — início"><span class="identity-mark" aria-hidden="true">T.</span><div><h1>Thiago Nascimento</h1><p>Desenvolvedor · DSM / FATEC São José dos Campos</p></div></a>
</header>
<nav class="menu" aria-label="Seções do portfólio" transition:name="menu" transition:animate="initial">
{sections.map((s, idx) => <a class:list={["menu-item",{ "is-selected": active === s.id }]} href={route(s.id)} data-section={s.id} style={`--accent:${s.accent};--on-accent:${s.onAccent}`} aria-current={!home && active === s.id ? 'page' : undefined} aria-label={s.label}><span class="arrow" aria-hidden="true"></span><span class="menu-word" data-text={s.label.toUpperCase()} aria-hidden="true">{[...s.label].map((letter,i)=><span class="menu-letter" style={`--letter:${i}`}>{letter}</span>)}</span><span class="menu-meta" aria-hidden="true"><b class="menu-idx">0{idx+1}</b><small class="menu-hint">{s.hint}</small></span></a>)}
{!home&&<span class="menu-splash" aria-hidden="true"></span>}
</nav>
<div class="vertical-note">Uma trajetória em construção</div>
