---
// Selo heptagonal dos menus de Metaphor: dois heptágonos e os raios do centro a cada vértice externo.
const outer=[[50,3],[90,22],[99,65],[72,97],[28,97],[1,65],[10,22]];
const inner='50,16 79,30 86,62 66,85 34,85 14,62 21,30';
---
<svg viewBox="0 0 100 100"><polygon points={outer.join(' ')}/><polygon points={inner}/>{outer.map(([x,y])=><line x1={x} y1={y} x2="50" y2="50"/>)}</svg>
