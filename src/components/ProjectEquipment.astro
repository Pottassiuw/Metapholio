---
// Detalhe de projeto como cena Equipment, com navegação factual e conteúdo acessível sem JavaScript.
import {projects,sections,route,asset} from '../data/portfolio';
import '../styles/equipment.css';
interface Props{project:(typeof projects)[number];section:(typeof sections)[number]}
const {project,section}=Astro.props;
const tabs=[
 {id:'problem',label:'O problema',title:'O ponto de partida',text:project.problem},
 {id:'solution',label:'A solução',title:'A resposta construída',text:project.solution},
 {id:'role',label:'Minha contribuição',title:'Minha parte',text:project.role},
 {id:'tech',label:'Tecnologias',title:'Ferramentas do projeto'},
 {id:'skills',label:'Competências',title:'Competências em prática'},
 {id:'sources',label:'Fontes',title:'Fontes e disponibilidade'},
];
const fragment=project.id==='api-altave'?'poliedro':project.id==='weeat'?'quadrado':project.id==='edp-helios'?'ampulheta':project.id==='reobserve'?'balanca':'sino';
const word=project.name.toUpperCase();
---
<section class="scene equipment-scene" id="conteudo" data-scene="equipment" aria-labelledby="equipment-title">
 <div class="scene-ground" aria-hidden="true"><span class="scene-stain"></span><span class="scene-line"></span><span class="scene-orbit"></span></div>
 <picture class="scene-art" aria-hidden="true"><source type="image/avif" srcset={asset(`images/frag-${fragment}.avif`)}/><img src={asset(`images/frag-${fragment}.webp`)} alt="" width="900" height="900" loading="eager"/></picture>
 <h1 class="scene-title equipment-title" id="equipment-title"><span class="sr-only">{project.name}</span><span class="equipment-word" aria-hidden="true">{[...word].map((letter,i)=><span class="scene-letter" style={`--i:${i}`} aria-hidden="true">{letter===' '?<span class="equipment-space">&nbsp;</span>:letter}</span>)}</span></h1>
 <div class="scene-body equipment-body">
  <header class="equipment-masthead"><a class="equipment-return" href={route(section.id)}>← {section.title}</a><p>{project.context}</p></header>
  <div class="equipment-stage">
   <nav class="equipment-nav" aria-label="Conteúdo do projeto">{tabs.map((tab,i)=><a class:list={['equipment-tab',{active:i===0}]} href={`#${tab.id}`} data-tab={tab.id} aria-current={i===0?'location':undefined}><span>{tab.label}</span></a>)}</nav>
   <div class="equipment-readings" aria-label="Detalhes do projeto">
    {tabs.map(tab=><section class="equipment-reading" id={tab.id} data-reading={tab.id} aria-labelledby={`${tab.id}-heading`}>
     <h2 id={`${tab.id}-heading`}>{tab.title}</h2>
     {['problem','solution','role'].includes(tab.id)&&<p>{tab.text}</p>}
     {tab.id==='tech'&&<ul class="equipment-tags">{project.tech.map(t=><li>{t}</li>)}</ul>}
     {tab.id==='skills'&&<><ul class="equipment-skills">{project.skills.map(s=><li>{s}</li>)}</ul><p class="equipment-note">As competências descrevem atividades documentadas; não são notas de proficiência.</p></>}
     {tab.id==='sources'&&<><p>{project.note}</p>{project.links.length>0&&<div class="equipment-links">{project.links.map(l=><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}<span aria-hidden="true">↗</span></a>)}</div>}<details class="equipment-pending"><summary>Pendências de informação</summary><p>{project.pending}</p></details></>}
    </section>)}
   </div>
  </div>
  <figure class="equipment-art-caption"><figcaption><strong>{project.subtitle}</strong><span>{project.lead}</span></figcaption></figure>
  <div class="equipment-visual" aria-label={project.id==='edp-helios'?'Seções do projeto · esquema editorial, não uma tela real':'Conceitos do projeto'}>
   <span>{project.id==='edp-helios'?'ESQUEMA EDITORIAL':'NO CAMPO DESTE PROJETO'}</span>
   {project.id==='edp-helios'&&<p class="editorial-label">Esquema editorial · não é uma tela real</p>}
   <ol>{project.visual.map(item=><li>{item}</li>)}</ol>
  </div>
  <nav class="equipment-next" aria-label="Continuar explorando"><h2>Outro equipamento</h2>{projects.filter(p=>p.id!==project.id&&p.category===project.category).map(p=><a href={route(p.id)}>{p.name}<span aria-hidden="true">↗</span></a>)}<a href={route(section.id)}>Todos em {section.label.toLowerCase()}<span aria-hidden="true">↗</span></a></nav>
 </div>
</section>
<script>
let controller:AbortController|null=null;
function initEquipment(){
 controller?.abort();const root=document.querySelector<HTMLElement>('[data-equipment]');if(!root)return;
 controller=new AbortController();const {signal}=controller;const tabs=[...root.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
 function activate(id:string){tabs.forEach(tab=>{const active=tab.dataset.tab===id;tab.classList.toggle('active',active);if(active)tab.setAttribute('aria-current','location');else tab.removeAttribute('aria-current');});}
 tabs.forEach(tab=>tab.addEventListener('click',event=>{const id=tab.dataset.tab;if(!id)return;activate(id);const target=root.querySelector<HTMLElement>(`#${id}`);if(target){event.preventDefault();history.replaceState(null,'',`#${id}`);target.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'center'});}}, {signal}));
 const observer=new IntersectionObserver(entries=>{const visible=entries.filter(entry=>entry.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0];if(visible)activate((visible.target as HTMLElement).dataset.reading??'');},{rootMargin:'-25% 0px -55% 0px',threshold:[0,.2,.5]});
 root.querySelectorAll<HTMLElement>('[data-reading]').forEach(section=>observer.observe(section));signal.addEventListener('abort',()=>observer.disconnect(),{once:true});
 const hash=location.hash.slice(1);if(hash&&tabs.some(tab=>tab.dataset.tab===hash))activate(hash);
}
document.addEventListener('astro:page-load',initEquipment);
</script>
