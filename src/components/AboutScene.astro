---
// Seção Sobre como cena. O primeiro slide é a apresentação com a foto profissional (nome completo, formação,
// objetivos); os seguintes trocam a foto pelas pinturas de Thiago como personagem, com frases curtas.
// Sem JavaScript, os slides aparecem empilhados.
import {route} from '../data/portfolio';
import {constellation,GRADES,ROMAN as GRADE_ROMAN} from '../data/tech';
import TechMark from './TechMark.astro';
import Picture from './Picture.astro';
import SceneTitle from './SceneTitle.astro';
import Icon from './Icon.astro';
// Três pinturas de Thiago como personagem, uma por slide, em tela cheia (1672×941).
const art={
 perfil:{alt:'Pintura de Thiago Nascimento de perfil, olhando para o alto, entre nuvens, anéis de bússola e uma pincelada vermelha.'},
 biblioteca:{alt:'Pintura de Thiago Nascimento de casaco branco e luvas pretas, recostado numa poltrona azul com a mão na têmpora, numa biblioteca gótica com vitral, lâmpadas verdes, esfera armilar e um gato à esquerda, cortada por pinceladas vermelhas.'},
 cidade:{alt:'Pintura do perfil de Thiago Nascimento contendo uma cidade suspensa nas nuvens; abaixo, ele de casaco branco sobre ruínas.'},
} as const;
// Apresentação pessoal (roteiro do portfólio DSM, item 2.1).
const facts=[
 ['Nome','Thiago Batista Félix do Nascimento'],
 ['Formação','Desenvolvimento de Software Multiplataforma, 2º semestre · FATEC São José dos Campos'],
 ['Objetivo acadêmico','Concluir o DSM e seguir para uma pós-graduação ou um mestrado em inteligência artificial e machine learning.'],
 ['Objetivo profissional','Trabalhar com dados e IA. Hoje estou entre duas trilhas, engenharia de dados e engenharia de IA, e estudo as duas.'],
 ['Áreas de interesse','Arquitetura de sistemas, segurança da informação, dados e agentes de IA.'],
];
const slides=[
 {art:'foto',tag:'Apresentação',lines:['Prazer,','eu sou','o Thiago.']},
 {art:'perfil',tag:'Identidade',lines:['Entre aprender','e construir.'],note:'Antes do código vem a curiosidade: eu gosto de entender como as coisas funcionam por dentro.'},
 {art:'biblioteca',tag:'Arquitetura',lines:['Gosto de entender','como as partes','se conectam.'],note:'Me interessam arquitetura de sistemas e segurança da informação.',stars:true,links:[['Meus interesses','interesses']]},
 {art:'cidade',tag:'Trajetória',lines:['Do TCC na ETEC','ao estágio','na EDP.'],note:'Alguns projetos do caminho:',links:[['Weeat','weeat'],['ReObserve','reobserve'],['Helios','edp-helios'],['API Altave','api-altave']]},
] as const;
const ROMAN=['I','II','III','IV'];
---
<section class="about-scene" id="conteudo" aria-labelledby="about-title">
<div class="room-flood" aria-hidden="true"></div>
<SceneTitle class="about-title" id="about-title" text="SOBRE MIM" label="Sobre mim"/>
<div class="about-dossier" aria-label="Perfil rápido"><span>DSM · FATEC SJC</span><span>Estágio · EDP</span><span>São José dos Campos · SP</span></div>
<div class="about-slides" aria-roledescription="carrossel" aria-label="Quem é Thiago Nascimento">
{slides.map((s,i)=><article class:list={['about-slide',{'is-active':i===0}]} data-art={s.art} aria-roledescription="slide" aria-label={`${i+1} de ${slides.length}`}>
{s.art==='foto'
 ?<figure class="about-id"><Picture src="thiago/foto-frontal" width={900} height={900} alt="Foto de Thiago Nascimento, de frente, de óculos e camisa preta, sobre fundo escuro." loading="eager"/><figcaption>Thiago Batista Félix do Nascimento</figcaption></figure>
 :<Picture class="about-art" src={`thiago/pintura-${s.art}`} width={1672} height={941} alt={art[s.art].alt} loading="eager" fetchpriority={i===1?'auto':'low'} decoding="async"/>}
<div class="about-copy">
<p class="about-phrase">{s.lines.map(l=><span>{l}</span>)}</p>
{s.art==='foto'&&<>
<dl class="about-facts">{facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
<button class="about-reveal" type="button" data-step="1">Ver o retrato pintado<Icon name="arrow"/></button>
</>}
{'note' in s&&<p class="about-note">{s.note}</p>}
{'stars' in s&&<section class="constellation" aria-label="Tecnologias">{constellation.map(g=><div class="stars"><h3>{g.group}</h3><ul>{g.items.map((n,k)=><li style={`--k:${k}`}><TechMark name={n} size={24} grade="numeral"/></li>)}</ul></div>)}<p class="grade-legend"><span>Grau</span>{GRADES.map((g,i)=><span><b>{GRADE_ROMAN[i]}</b> {g}</span>)}</p></section>}
{'links' in s&&<ul class="about-links">{s.links.map(([label,id])=><li><a href={route(id)}>{label}<Icon name="arrow"/></a></li>)}</ul>}
</div>
</article>)}
</div>
<div class="about-controls" hidden>
<div class="about-chapters" role="group" aria-label="Capítulos de Sobre mim">{slides.map((s,i)=><button class:list={['about-pill',{'is-current':i===0}]} type="button" data-jump={i} aria-current={i===0?'step':undefined}>{ROMAN[i]} · {s.tag}</button>)}</div>
<button class="about-btn" type="button" data-step="-1" aria-label="Frase anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg></button>
<button class="about-btn" type="button" data-toggle aria-pressed="false" aria-label="Pausar"><svg class="about-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg><svg class="about-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l12-7z"/></svg></button>
<button class="about-btn" type="button" data-step="1" aria-label="Próxima frase"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
<p class="about-count"><b>1</b> / {slides.length}</p>
<span class="about-progress" aria-hidden="true"><span></span></span>
</div>
</section>

<script>
let controller:AbortController|null=null;
function initAbout(){
 controller?.abort();
 const scene=document.querySelector<HTMLElement>('.about-scene');if(!scene)return;
 controller=new AbortController();const {signal}=controller;
 const slides=[...scene.querySelectorAll<HTMLElement>('.about-slide')];
 const controls=scene.querySelector<HTMLElement>('.about-controls')!;
 const list=scene.querySelector<HTMLElement>('.about-slides')!;
 const toggle=scene.querySelector<HTMLButtonElement>('[data-toggle]')!;
 const pills=[...scene.querySelectorAll<HTMLButtonElement>('[data-jump]')];
 const count=scene.querySelector('.about-count b')!;
 const bar=scene.querySelector<HTMLElement>('.about-progress span')!;
 scene.classList.add('is-carousel');controls.hidden=false;scene.dataset.index='0';
 let index=0;
 function show(next:number,dir:1|-1){
  const prev=index;index=(next+slides.length)%slides.length;
  scene!.dataset.dir=String(dir);
  slides.forEach((s,k)=>{s.classList.toggle('is-active',k===index);s.classList.toggle('is-leaving',k===prev&&prev!==index);s.inert=k!==index;});
  pills.forEach((p,k)=>{p.classList.toggle('is-current',k===index);if(k===index)p.setAttribute('aria-current','step');else p.removeAttribute('aria-current');});
  count.textContent=String(index+1);scene!.dataset.index=String(index);
  // Reinicia a barra: é a animação dela que avança o carrossel.
  bar.style.animation='none';void bar.offsetWidth;bar.style.animation='';
 }
 function setPaused(paused:boolean){
  scene!.classList.toggle('is-paused',paused);
  toggle.setAttribute('aria-pressed',String(paused));toggle.setAttribute('aria-label',paused?'Retomar':'Pausar');
  list.setAttribute('aria-live',paused?'polite':'off');
 }
 slides.forEach((s,k)=>{s.inert=k!==0});
 setPaused(matchMedia('(prefers-reduced-motion: reduce)').matches);
 bar.addEventListener('animationend',()=>show(index+1,1),{signal});
 pills.forEach(p=>p.addEventListener('click',()=>{const k=Number(p.dataset.jump);show(k,k>=index?1:-1);},{signal}));
 scene.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(b=>b.addEventListener('click',()=>show(index+Number(b.dataset.step),Number(b.dataset.step) as 1|-1),{signal}));
 toggle.addEventListener('click',()=>setPaused(!scene.classList.contains('is-paused')),{signal});
 // Segura o autoplay enquanto o visitante lê a frase ou usa os controles. A cena ocupa a tela
 // inteira (fica atrás do menu), então segurar pela cena toda pararia o carrossel com qualquer mouse.
 scene.querySelectorAll<HTMLElement>('.about-copy,.about-controls').forEach(el=>{
  el.addEventListener('pointerenter',()=>scene.classList.add('is-held'),{signal});
  el.addEventListener('pointerleave',()=>scene.classList.remove('is-held'),{signal});
 });
 scene.addEventListener('focusin',()=>scene.classList.add('is-held-focus'),{signal});
 scene.addEventListener('focusout',e=>{if(!scene.contains(e.relatedTarget as Node))scene.classList.remove('is-held-focus')},{signal});
 document.addEventListener('keydown',e=>{
  if((e.target as HTMLElement).closest('.menu,.trilha,input,textarea,select,[contenteditable]'))return;
  if(e.key==='ArrowRight')show(index+1,1);else if(e.key==='ArrowLeft')show(index-1,-1);
 },{signal});
}
document.addEventListener('astro:page-load',initAbout);
</script>
