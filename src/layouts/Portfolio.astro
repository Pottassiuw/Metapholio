---
import MenuArt from '../components/MenuArt.astro';
import {route,asset} from '../data/portfolio';
import '../styles/menu.css';
import '../styles/portfolio.css';
const {title='Thiago Nascimento — Metapholio',description='Portfólio de Thiago Nascimento: desenvolvimento de software, projetos acadêmicos e experiência profissional.',active='projetos',home=false}=Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#73c9c5"/>
<title>{title}</title><meta name="description" content={description}/>
<link rel="icon" type="image/svg+xml" href={asset('favicon.svg')}/>
</head>
<body>
<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
<main class:list={['stage',home?'home':'inner']} id="menu">
<MenuArt active={active}/>
{home ? <slot/> : <article class="content-sheet" id="conteudo" aria-label={title}>
<div class="sheet-tools"><a href={route()} class="back-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg> Voltar ao menu</a><span>Metapholio / Thiago Nascimento</span></div>
<slot/>
<footer class="sheet-footer"><a href={route('contato')}>Vamos conversar</a><a href={route()}>Menu principal</a></footer>
</article>}
<footer class="footer">
<div><p>O próximo capítulo começa com uma ideia.</p><div class="social"><a href="https://github.com/Pottassiuw" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://www.linkedin.com/in/thiago-nascimento-729077292" target="_blank" rel="noopener noreferrer">LinkedIn</a></div><p class="caption">Retrato: Thiago Nascimento · Gravura: A. Dürer / The Met, domínio público.</p></div>
<div class="controls"><span class="control"><span class="key-arrows"><kbd>↑</kbd><kbd>↓</kbd></span> Navegar</span><span class="control"><kbd>Enter</kbd> Abrir</span><span class="control"><kbd>Esc</kbd> Menu</span></div>
</footer>
</main>
<script>
import {route,sections} from '../data/portfolio';
const controller=new AbortController();const {signal}=controller;
const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-section]')];
const stage=document.querySelector<HTMLElement>('.stage')!;
const home=stage.classList.contains('home');
function ground(){
 if(!home&&window.innerWidth>700)return;
 const el=links[5];if(!el)return;const b=el.getBoundingClientRect(),f=stage.getBoundingClientRect();
 const angle=(window.innerWidth<=700?6:8)*Math.PI/180,slope=Math.tan(angle);
 const left=b.top-f.top+Math.sin(angle)*el.offsetWidth+slope*(b.left-f.left)+2;
 stage.style.setProperty('--cut-left',left+'px');stage.style.setProperty('--cut-mid',(left-slope*f.width*.66)+'px');stage.style.setProperty('--cut-right',(left-slope*f.width)+'px');
}
window.addEventListener('resize',ground,{passive:true,signal});document.fonts.ready.then(ground);
function select(link:HTMLAnchorElement){if(!home)return;links.forEach(el=>el.classList.toggle('is-selected',el===link));const s=sections.find(s=>s.id===link.dataset.section)!;document.querySelector('#preview-title')!.textContent=s.title;document.querySelector('#preview-copy')!.textContent=s.copy;const explore=document.querySelector<HTMLAnchorElement>('#explore')!;explore.href=link.href;explore.querySelector('span')!.textContent='Explorar '+s.label.toLowerCase();}
links.forEach(link=>{link.addEventListener('focus',()=>select(link),{signal});link.addEventListener('pointerenter',()=>{if(matchMedia('(hover:hover)').matches)select(link)},{signal});});
document.addEventListener('keydown',e=>{if(/INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement).tagName))return;if(e.key==='Escape'&&!home){location.href=route();return;}if(!['ArrowDown','ArrowUp'].includes(e.key))return;e.preventDefault();let i=links.findIndex(l=>l===document.activeElement);if(i<0)i=links.findIndex(l=>l.classList.contains('is-selected'));links[(i+(e.key==='ArrowDown'?1:-1)+links.length)%links.length].focus();},{signal});
</script>
</body></html>
