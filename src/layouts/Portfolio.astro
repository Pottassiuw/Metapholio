---
import {ClientRouter} from 'astro:transitions';
import MenuArt from '../components/MenuArt.astro';
import Trilha from '../components/Trilha.astro';
import Atmosfera from '../components/Atmosfera.astro';
import {route,asset,sections} from '../data/portfolio';
import '../styles/menu.css';
import '../styles/portfolio.css';
import '../styles/trilha.css';
import '../styles/about.css';
import '../styles/scenes.css';
import '../styles/rooms.css';
import '../styles/tech.css';
const {title='Thiago Nascimento — Metapholio',description='Portfólio de Thiago Nascimento: desenvolvimento de software, projetos acadêmicos e experiência profissional.',active='projetos',home=false,routeKey='menu',immersive=false,scene=false}=Astro.props;
const current=sections.find(s=>s.id===active)??sections[1];
---
<!doctype html>
<html lang="pt-BR" data-screen={home?'home':'inner'} data-route={routeKey} data-page-section={current.id} style={`--accent:${current.accent};--on-accent:${current.onAccent};--accent-sel:${current.accent}`} transition:animate="none">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#73c9c5"/>
<title>{title}</title><meta name="description" content={description}/>
<link rel="icon" type="image/svg+xml" href={asset('favicon.svg')}/>
<ClientRouter fallback="swap"/>
</head>
<body>
<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
<main class:list={['stage',home?'home':'inner',{immersive,'section-scene':scene}]} id="menu">
<MenuArt active={active}/>
{home||immersive||scene ? <slot/> : <article class="content-sheet" id="conteudo" aria-label={title}>
<div class="sheet-tools"><a href={route()} class="back-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg> Voltar ao menu</a><span>Metapholio / Thiago Nascimento</span></div>
<slot/>
<footer class="sheet-footer"><a href={route('contato')}>Vamos conversar</a><a href={route()}>Menu principal</a></footer>
</article>}
<footer class="footer">
<div><div class="social"><a href="https://github.com/Pottassiuw" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://www.linkedin.com/in/thiago-nascimento-729077292" target="_blank" rel="noopener noreferrer">LinkedIn</a></div><p class="caption">Gravura: A. Dürer, Melencolia I (1514), The Met — domínio público.</p></div>
<div class="controls"><span class="control"><span class="key-arrows"><kbd>↑</kbd><kbd>↓</kbd></span> Navegar</span><span class="control"><kbd>Enter</kbd> Abrir</span><span class="control"><kbd>Esc</kbd> Menu</span></div>
</footer>
</main>
<Trilha/>
<Atmosfera/>
<script>
import {navigate,swapFunctions} from 'astro:transitions/client';
import {route,sections,projects} from '../data/portfolio';

let lastTap:{x:number,y:number,el:Element|null,t:number}={x:0,y:0,el:null,t:0};
document.addEventListener('pointerdown',e=>{
 lastTap={x:e.clientX,y:e.clientY,el:(e.target as Element|null)?.closest?.('a,button')??null,t:performance.now()};
},{passive:true,capture:true});

// Troca só o palco (#menu): o resto do <body>, inclusive a trilha e a atmosfera, continua vivo entre páginas.
document.addEventListener('astro:before-swap',event=>{
 const next=event.newDocument.getElementById('menu'),current=document.getElementById('menu');
 if(!next||!current)return;
 event.swap=()=>{
  if(document.documentElement.classList.contains('has-splash'))event.newDocument.documentElement.classList.add('has-splash');
  swapFunctions.deselectScripts(event.newDocument);
  swapFunctions.swapRootAttributes(event.newDocument);
  swapFunctions.swapHeadElements(event.newDocument);
  const restoreFocus=swapFunctions.saveFocus();
  document.querySelectorAll('.astro-route-announcer').forEach(el=>el.remove());
  current.replaceWith(next);
  restoreFocus();
 };
});

// Saída no idioma de Metaphor: quando a atmosfera WebGL está ativa, dispara um respingo de tinta do ponto
// de clique/foco na cor da seção de destino; sem WebGL, mantém a faixa de papel cruzando a tela.
document.addEventListener('astro:before-preparation',event=>{
 const stage=document.querySelector<HTMLElement>('.stage');
 if(!stage||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
 let x=innerWidth*.5,y=innerHeight*.5,link:HTMLAnchorElement|null=null;
 if(performance.now()-lastTap.t<600){
  x=lastTap.x;y=lastTap.y;link=lastTap.el?.closest?.('a')??null;
 }else{
  const act=document.activeElement as HTMLElement|null;
  const focusEl=(act&&act!==document.body&&act!==document.documentElement?act:null)
   ??document.querySelector<HTMLElement>('.menu-item.is-painted,.menu-item.is-selected');
  const b=focusEl?.getBoundingClientRect();
  if(b&&b.width>0){x=b.left+b.width*.55;y=b.top+b.height*.5;}
  link=focusEl?.closest?.('a')??null;
 }
 const slug=event.to.pathname.replace(/\/+$/,'').split('/').pop()||'';
 const secId=link?.dataset.section||sections.find(s=>s.id===slug)?.id||projects.find(p=>p.id===slug)?.category;
 const cor=sections.find(s=>s.id===secId)?.accent
  ||getComputedStyle(document.documentElement).getPropertyValue('--accent-sel').trim()||'#ff3461';
 (window as unknown as {__splash?:(x:number,y:number,c?:string)=>boolean}).__splash?.(x,y,cor);
 const load=event.loader;
 event.loader=async()=>{
  stage.classList.add('is-leaving');
  await Promise.all([load(),new Promise(r=>setTimeout(r,320))]);
 };
});

let controller:AbortController|null=null;
function init(){
 controller?.abort();controller=new AbortController();const {signal}=controller;
 const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-section]')];
 const stage=document.querySelector<HTMLElement>('.stage')!;
 const home=stage.classList.contains('home');
 function ground(){
  if(!home&&window.innerWidth>700)return;
  const el=links[5];if(!el)return;const b=el.getBoundingClientRect(),f=stage.getBoundingClientRect();
  const angle=(window.innerWidth<=700?6:8)*Math.PI/180,slope=Math.tan(angle);
  // Recover the rotated top-left corner, not the bounding box's bottom-left.
  // Keep the dark ground below Formação even after fonts and selection settle.
  const left=b.top-f.top+Math.sin(angle)*el.offsetWidth+slope*(b.left-f.left+Math.sin(angle)*el.offsetHeight)-2;
  stage.style.setProperty('--cut-left',left+'px');stage.style.setProperty('--cut-mid',(left-slope*f.width*.66)+'px');stage.style.setProperty('--cut-right',(left-slope*f.width)+'px');
 }
 window.addEventListener('resize',ground,{passive:true,signal});document.fonts.ready.then(()=>{if(!signal.aborted)ground();});
 // Seleção no idioma do menu de Metaphor: a cor da seção inunda o fundo e uma mancha é repintada atrás
 // da linha; as letras pulam. Na hero também muda a prévia e o dial; nas internas é só a pintura (sai ao deixar o menu).
 const root=document.documentElement;
 const splash=document.querySelector<HTMLElement>('.menu-splash');
 const floods=[...document.querySelectorAll<HTMLElement>('.room-flood')];
 const replay=(el:Element|null,cls:string)=>{if(!el)return;el.classList.remove(cls);void (el as HTMLElement).offsetWidth;el.classList.add(cls);};
 let painted:HTMLAnchorElement|null=null;
 const still=matchMedia('(prefers-reduced-motion: reduce)');
 // Respingos de tinta da ponta da pincelada: gotas e riscos na cor da seção e em tinta, com um arco de queda.
 function burst(link:HTMLAnchorElement,accent:string){
  const menu=link.parentElement;if(!menu||still.matches)return;
  const x0=link.offsetLeft+link.offsetWidth*.92,y0=link.offsetTop+link.offsetHeight*.52,unit=link.offsetHeight/100;
  for(let i=0;i<24;i++){
   const streak=i%5===0,el=document.createElement('span');
   const size=(streak?4:6+Math.random()*20)*unit,len=streak?(40+Math.random()*80)*unit:size*(.8+Math.random()*.6);
   el.className=streak?'fleck is-streak':'fleck';el.setAttribute('aria-hidden','true');
   el.style.cssText=`width:${len}px;height:${size}px;--c:${Math.random()<.72?accent:'#101c20'}`;
   menu.appendChild(el);
   const dx=(60+Math.random()*420)*unit,dy=(Math.random()-.62)*170*unit,fall=(30+Math.random()*70)*unit,spin=(Math.random()-.5)*160;
   const from=`translate(${x0}px,${y0-size/2}px) rotate(${streak?-4:0}deg) scale(.2)`;
   el.animate([{transform:from,opacity:1},{transform:`translate(${x0+dx*.7}px,${y0+dy}px) rotate(${spin*.6}deg) scale(1)`,opacity:1,offset:.45},{transform:`translate(${x0+dx}px,${y0+dy+fall}px) rotate(${spin}deg) scale(.35)`,opacity:0}],{duration:620+Math.random()*420,delay:Math.random()*90,easing:'cubic-bezier(.16,1,.3,1)',fill:'backwards'}).finished.then(()=>el.remove(),()=>el.remove());
  }
 }
 function paint(link:HTMLAnchorElement){
  if(painted===link)return;painted=link;
  const s=sections.find(s=>s.id===link.dataset.section)!;
  root.style.setProperty('--accent-sel',s.accent);root.style.setProperty('--on-sel',s.onAccent);
  if(splash){splash.style.setProperty('--y',(link.offsetTop+link.offsetHeight/2)+'px');splash.style.setProperty('--h',(link.offsetHeight*2.4)+'px');replay(splash,'is-painting');}
  floods.forEach(f=>replay(f,'is-painting'));
  links.forEach(el=>el.classList.toggle('is-painted',el===link));
  replay(link,'is-pop');
  burst(link,s.accent);
 }
 function misprint(el:HTMLElement|null){
  if(!el||still.matches||document.hidden)return;
  replay(el,'is-misprint');
  window.setTimeout(()=>el.classList.remove('is-misprint'),300);
 }
 function select(link:HTMLAnchorElement){
  paint(link);
  if(!home||link.classList.contains('is-selected'))return;
  links.forEach(el=>el.classList.toggle('is-selected',el===link));
  misprint(link.querySelector<HTMLElement>('.menu-word'));
  const s=sections.find(s=>s.id===link.dataset.section)!;
  const idx=sections.indexOf(s)+1;
  const num=document.querySelector<HTMLElement>('.dial-num');if(num){num.textContent=String(idx);replay(num,'is-turning');}
  const rk=document.querySelector<HTMLElement>('#preview-rank');if(rk){rk.textContent=String(idx);replay(rk,'is-turning');}
  const tag=document.querySelector<HTMLElement>('#preview-tag');if(tag)tag.textContent=s.hint;
  document.querySelector('#preview-title')!.textContent=s.title;document.querySelector('#preview-copy')!.textContent=s.copy;const explore=document.querySelector<HTMLAnchorElement>('#explore')!;explore.href=link.href;explore.querySelector('span')!.textContent='Explorar '+s.label.toLowerCase();
 }
 const current=links.find(l=>l.classList.contains('is-selected'));
 if(current){painted=null;paint(current);}
 const titleEl=document.querySelector<HTMLElement>('.scene-title'),wordEl=titleEl?.querySelector<HTMLElement>('.scene-word')??null;
 if(titleEl&&wordEl){
  let mTimer=window.setTimeout(()=>{if(!signal.aborted)misprint(wordEl);},320);
  const schedule=()=>{mTimer=window.setTimeout(()=>{if(signal.aborted)return;misprint(wordEl);schedule();},7000+Math.random()*4000);};
  const iTimer=window.setTimeout(()=>{if(!signal.aborted)schedule();},650);
  signal.addEventListener('abort',()=>{clearTimeout(mTimer);clearTimeout(iTimer);});
  titleEl.addEventListener('pointerenter',()=>misprint(wordEl),{signal});
 }
 const follower=document.querySelector<HTMLElement>('.follower');
 if(follower){
  const bonds=[...follower.querySelectorAll<HTMLAnchorElement>('.message')];
  const bRank=follower.querySelector<HTMLElement>('#bond-rank'),bArch=follower.querySelector<HTMLElement>('#bond-arch'),bCopy=follower.querySelector<HTMLElement>('#bond-copy');
  let bIdx=0;
  const setBond=(k:number,focus=false)=>{
   bIdx=(k+bonds.length)%bonds.length;const el=bonds[bIdx];if(!el)return;
   bonds.forEach((m,i)=>m.classList.toggle('is-active',i===bIdx));
   if(bRank&&bRank.textContent!==el.dataset.rank){bRank.textContent=el.dataset.rank??'I';replay(bRank,'is-turning');}
   if(bArch)bArch.textContent=el.dataset.arch??'';
   if(bCopy)bCopy.textContent=el.dataset.desc??'';
   if(focus)el.focus();
  };
  bonds.forEach((m,i)=>{
   m.addEventListener('pointerenter',()=>setBond(i),{signal});
   m.addEventListener('focus',()=>setBond(i),{signal});
  });
  follower.querySelectorAll<HTMLButtonElement>('[data-bond-step]').forEach(btn=>{
   btn.addEventListener('click',()=>setBond(bIdx+Number(btn.dataset.bondStep),true),{signal});
  });
 }
 const lvRows=[...document.querySelectorAll<HTMLElement>('.level-row')];
 lvRows.forEach(r=>r.addEventListener('pointerenter',()=>lvRows.forEach(x=>x.classList.toggle('is-peak',x===r)),{signal}));
 links.forEach(link=>{link.addEventListener('focus',()=>select(link),{signal});// Pelo tipo do ponteiro, não por (hover:hover): o Firefox no Linux com tela de toque responde 'none' mesmo com mouse.
  link.addEventListener('pointerenter',e=>{if(e.pointerType!=='touch')select(link)},{signal});});
 // Nas internas, ao sair do menu a pintura volta para a seção da página.
 const menu=document.querySelector<HTMLElement>('.menu');
 if(!home&&menu&&current){
  menu.addEventListener('pointerleave',()=>paint(current),{signal});
  menu.addEventListener('focusout',e=>{if(!menu.contains(e.relatedTarget as Node))paint(current)},{signal});
 }
 document.addEventListener('keydown',e=>{if(/INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement).tagName))return;if(e.key==='Escape'&&!home){navigate(route());return;}if(!['ArrowDown','ArrowUp'].includes(e.key))return;e.preventDefault();let i=links.findIndex(l=>l===document.activeElement);if(i<0)i=links.findIndex(l=>l.classList.contains('is-selected'));links[(i+(e.key==='ArrowDown'?1:-1)+links.length)%links.length].focus();},{signal});
}
document.addEventListener('astro:page-load',init);
</script>
</body></html>
