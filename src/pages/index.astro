---
import Portfolio from '../layouts/Portfolio.astro';
import {route} from '../data/portfolio';
---
<Portfolio home routeKey="menu">
<section class="preview" id="conteudo" aria-label="Seção selecionada">
<h2 class="preview-title" id="preview-title">Projetos acadêmicos</h2>
<p class="preview-copy" id="preview-copy">As APIs da FATEC, trabalhos de disciplina e o TCC da ETEC.</p>
<a class="preview-action" id="explore" href={route('projetos')}><span>Explorar projetos</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
</section>
</Portfolio>
