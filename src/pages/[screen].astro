---
import Portfolio from '../layouts/Portfolio.astro';
import AboutScene from '../components/AboutScene.astro';
import ProjectEquipment from '../components/ProjectEquipment.astro';
import SectionScene from '../components/SectionScene.astro';
import {sections,projects} from '../data/portfolio';
export function getStaticPaths(){return [...sections.map(s=>({params:{screen:s.id}})),...projects.map(p=>({params:{screen:p.id}}))]}
const id=Astro.params.screen;
const project=projects.find(p=>p.id===id);
const section=sections.find(s=>s.id===(project?.category??id))!;
const title=project?.name??section.title;
---
<Portfolio title={`${title} — Thiago Nascimento`} active={section.id} routeKey={id} immersive={id==='sobre'} scene={id!=='sobre'} description={project?.lead??section.copy}>
{project ? <>
<ProjectEquipment project={project} section={section}/>
</> : <>
{id==='sobre'?<AboutScene/>:<SectionScene section={section}/>}
</>}
</Portfolio>
